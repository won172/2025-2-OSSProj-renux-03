# RenuxServer(.NET) 환경변수 예시 — 실제 값은 절대 커밋하지 말 것.
# 운영에서는 이 파일이 아니라 시크릿 매니저(예: fly secrets set KEY=...)를 사용한다.

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<db-password>
POSTGRES_DB=<db-name>
# Npgsql 연결 문자열 (POSTGRES_* 값과 일치해야 함)
CONNECTIONSTRING="Host=db; Port=5432; Database=<db-name>; Username=postgres; Password=<db-password>"

# JWT 서명 키 (base64 인코딩된 충분히 긴 무작위 키)
JWT_KEY=<base64-encoded-random-signing-key>

# Product analytics identifiers are HMAC-pseudonymized. Rotate both values
# together; old aggregate rows remain separated by key id.
TELEMETRY_HMAC_KEY=<base64-encoded-random-analytics-key>
TELEMETRY_KEY_ID=v1
# Local/automation stacks should use true. A production student baseline must
# explicitly use false and keep privileged roles excluded automatically.
TELEMETRY_EXCLUDE_TRAFFIC=true
# Optional secret header value for marking external automation traffic excluded.
TELEMETRY_TEST_KEY=<random-test-traffic-secret>
RAG_BUILD_REVISION=local-unversioned

# RAG 서비스 (docker compose 내부 서비스명)
RAG_SERVICE_URL=http://rag-service:8000

# OpenAI (라우터/질의분석/생성에 사용)
OPENAI_API_KEY=sk-your-openai-api-key

# Redis
REDIS_URL=redis://redis:6379/0

# CORS 허용 오리진 (콤마 구분). 운영 도메인을 명시할 것.
# 웹 프런트와 Capacitor iOS 기본 origin을 모두 명시한다. 와일드카드는 쿠키 인증과 함께 쓸 수 없다.
CORS_ALLOWED_ORIGINS=https://your-domain.example,capacitor://localhost

# 인증 쿠키 보안 속성 (HTTPS 운영에서는 true 권장)
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
GUEST_COOKIE_SECURE=true
GUEST_COOKIE_SAMESITE=Lax
