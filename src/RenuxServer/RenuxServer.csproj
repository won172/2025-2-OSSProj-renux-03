<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f712c494-8c22-41de-8567-260baaabf195</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RenuxServer.ContractTests" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="FluentValidation" Version="12.0.0" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <!-- Publish only compiled SPA/PWA artifacts; wwwroot/frontend is source code. -->
    <Content Remove="wwwroot/**" />
    <Content Include="wwwroot/assets/**;wwwroot/icons/**;wwwroot/index.html;wwwroot/manifest.webmanifest;wwwroot/registerSW.js;wwwroot/sw.js;wwwroot/workbox-*.js"
             CopyToPublishDirectory="PreserveNewest" />
    <None Remove="wwwroot/frontend/**;wwwroot/*.zip;wwwroot/React.md;wwwroot/README.md;wwwroot/.env*;wwwroot/.gitignore;wwwroot/.DS_Store;wwwroot/vite.svg" />
  </ItemGroup>

</Project>
