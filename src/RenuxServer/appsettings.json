{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RagServiceUrl": "http://rag-service:8000",
  "RagRelayTimeouts": {
    "Stream": { "ConnectSeconds": 10, "FirstByteSeconds": 60, "InactivitySeconds": 60, "TotalSeconds": 180 },
    "Followups": { "ConnectSeconds": 10, "FirstByteSeconds": 30, "InactivitySeconds": 30, "TotalSeconds": 90 }
  }
}
