{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/sync-static.mjs",
    "build:native": "tsc -b && vite build --mode native",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios",
    "build:sync": "node scripts/sync-static.mjs",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "bootstrap": "^5.3.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.18.2",
    "rehype-external-links": "^3.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.10.29",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.3.0"
  }
}
