{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dongttok.local/schemas/golden-run-manifest-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "runner_version", "run_id", "run_started_at", "run_completed_at", "endpoint", "as_of", "endpoint_ready_status", "endpoint_ready_payload_hash", "header_names", "matrix_sha256", "taxonomy_version", "taxonomy_sha256", "results_sha256", "result_count", "expected_result_count", "selected_case_ids", "complete", "release_eligible", "failed_case_ids", "git", "candidate_fingerprint", "candidate_fingerprint_sha256", "candidate_fingerprint_end_sha256", "candidate_fingerprint_stable", "candidate_config", "data_manifest_hash", "data_files"],
  "properties": {
    "schema_version": {"const": 2},
    "runner_version": {"const": "real-http-v5-async-followups"},
    "run_id": {"type": "string", "format": "uuid"},
    "run_started_at": {"type": "string", "format": "date-time"},
    "run_completed_at": {"type": "string", "format": "date-time"},
    "endpoint": {"type": "string", "format": "uri"},
    "as_of": {"type": "string", "format": "date"},
    "endpoint_ready_status": {"type": "integer", "minimum": 0, "maximum": 599},
    "endpoint_ready_payload_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "header_names": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taxonomy_version": {"const": "student-domain-app-intent-v1"},
    "taxonomy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "results_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_count": {"type": "integer", "minimum": 0},
    "expected_result_count": {"type": "integer", "minimum": 160},
    "selected_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "complete": {"type": "boolean"},
    "release_eligible": {"type": "boolean"},
    "failed_case_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["commit_sha", "dirty", "diff_sha256"],
      "properties": {
        "commit_sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|unavailable)$"},
        "dirty": {"type": "boolean"},
        "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate_config": {
      "type": "object", "additionalProperties": false,
      "required": ["llm_provider", "query_analysis_model", "router_model", "evidence_selection_model", "grounding_model", "answer_model", "embedding_model", "embedding_revision", "embedding_device", "reranker_enabled", "reranker_model", "reranker_revision", "top_k", "routerless", "scheduler_enabled"],
      "properties": {
        "llm_provider": {"type": "string", "minLength": 1},
        "query_analysis_model": {"type": "string", "minLength": 1},
        "router_model": {"type": "string", "minLength": 1},
        "evidence_selection_model": {"type": "string", "minLength": 1},
        "grounding_model": {"type": "string", "minLength": 1},
        "answer_model": {"type": "string", "minLength": 1},
        "embedding_model": {"type": "string", "minLength": 1},
        "embedding_revision": {"type": ["string", "null"]},
        "embedding_device": {"type": "string", "minLength": 1},
        "reranker_enabled": {"type": "boolean"},
        "reranker_mode": {"enum": ["conditional", "always", "off"]},
        "reranker_model": {"type": ["string", "null"]},
        "reranker_revision": {"type": ["string", "null"]},
        "top_k": {"type": "integer", "minimum": 1},
        "retrieval_top_k_per_dataset": {"type": "integer", "minimum": 1},
        "active_notice_unknown_max_age_days": {"type": "integer", "minimum": 0},
        "single_query_retrieval": {"type": "boolean"},
        "recency_weight": {"type": "number", "minimum": 0, "maximum": 1},
        "hybrid_fusion_mode": {"type": "string", "minLength": 1},
        "hybrid_rrf_k": {"type": "integer", "minimum": 1},
        "lexical_retriever": {"enum": ["bm25", "tfidf_legacy"]},
        "chunk_size": {"type": "integer", "minimum": 1},
        "structured_chunk_size": {"type": "integer", "minimum": 1},
        "grounding_failure_policy": {"type": "string", "minLength": 1},
        "stream_buffer_until_grounded": {"type": "boolean"},
        "as_of_override_enabled": {"type": "boolean"},
        "routerless": {"type": "boolean"},
        "scheduler_enabled": {"type": "boolean"}
      }
    },
    "candidate_fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprint_end_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "candidate_fingerprint_stable": {"type": "boolean"},
    "candidate_fingerprint": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "build_revision", "answer_contract_version", "dense_index_ready", "runtime_config", "artifact_manifest_sha256", "artifacts", "datasets", "fingerprint_sha256"],
      "properties": {
        "schema_version": {"const": 1},
        "build_revision": {"type": "string", "minLength": 1},
        "answer_contract_version": {"const": "ask-response-v4-active-deadline"},
        "dense_index_ready": {"type": "boolean"},
        "runtime_config": {"$ref": "#/properties/candidate_config"},
        "artifact_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifacts": {"$ref": "#/properties/data_files"},
        "datasets": {
          "type": "array", "minItems": 6,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["key", "collection", "chroma_count", "cached_chunk_count", "dense_index_ready", "retrieval_mode", "chunk_artifact", "vectorizer_artifact"],
            "properties": {
              "key": {"type": "string", "minLength": 1},
              "collection": {"type": "string", "minLength": 1},
              "chroma_count": {"type": "integer", "minimum": 0},
              "cached_chunk_count": {"type": ["integer", "null"], "minimum": 0},
              "dense_index_ready": {"type": "boolean"},
              "retrieval_mode": {"enum": ["hybrid", "sparse_degraded"]},
              "lexical_retriever": {"type": ["string", "null"]},
              "chunk_artifact": {"type": ["string", "null"]},
              "vectorizer_artifact": {"type": ["string", "null"]}
            }
          }
        },
        "fingerprint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "data_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "data_files": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
