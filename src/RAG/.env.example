# RAG(FastAPI) 환경변수 예시 — 실제 값은 절대 커밋하지 말 것.
# 운영에서는 시크릿 매니저로 주입한다.

# OpenAI (라우터/질의분석은 항상 OpenAI 사용 → 필수)
OPENAI_API_KEY=sk-your-openai-api-key
# 기본 모델과 역할별 A/B 오버라이드. 역할별 값을 생략하면 각각
# OPENAI_MODEL(질의분석·라우터) 또는 OPENAI_CHAT_MODEL(나머지)을 따른다.
OPENAI_MODEL=gpt-4o-mini
OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_QUERY_ANALYSIS_MODEL=gpt-4o-mini
# OPENAI_ROUTER_MODEL=gpt-4o-mini
# OPENAI_EVIDENCE_MODEL=gpt-4o-mini
# OPENAI_GROUNDING_MODEL=gpt-4o-mini
RAG_NOTICE_IMAGE_OCR_ENABLED=1
RAG_NOTICE_IMAGE_OCR_MODEL=gpt-4o-mini
RAG_NOTICE_IMAGE_OCR_MAX_IMAGES=2
RAG_NOTICE_IMAGE_OCR_MAX_BYTES=5242880

# Redis (docker compose 내부 서비스명)
REDIS_URL=redis://redis:6379/0

# HuggingFace 토큰 (임베딩/리랭커 모델 다운로드 레이트 완화용, 선택)
HF_TOKEN=hf_your-huggingface-token

# 데이터 자동 갱신 스케줄러 (rag-service 프로세스 내부 APScheduler).
# 운영 배포에서 1로 켜면 공지/학식/교과과정을 주기적으로 자동 크롤·재인덱싱한다.
RAG_SCHEDULER_ENABLED=1
RAG_NOTICES_REFRESH_CRON="0 0,6,12,18 * * *"
RAG_RULES_REFRESH_CRON="0 2 * * 0"
RAG_MEALS_REFRESH_CRON="30 4 * * *"
RAG_COURSES_REFRESH_CRON="0 3 * * 0"
RAG_NOTICES_REFRESH_MAX_PAGES=5

# 검색/청킹. 장문 공지·규정은 A/B 결과 600자, 정형 행은 300자를 사용한다.
CHUNK_SIZE=600
STRUCTURED_CHUNK_SIZE=300
# RRF는 순위 점수이므로, 질의-근거 어휘 접점이 없을 때 적용할 원 검색점수 하한.
RRF_UNALIGNED_MIN_COMPONENT_SCORE=0.40
RERANKER_ENABLED=0
RERANKER_MODE=conditional
RERANKER_MAX_TOP_GAP=0.08
RERANKER_MIN_TEXT_CHARS=450
# 현재 진행 중 공지 중 마감일 미상 문서를 보수적으로 허용할 게시 경과일.
ACTIVE_NOTICE_UNKNOWN_MAX_AGE_DAYS=90
